<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jtools</groupId>
    <artifactId>xsdviewer-parent</artifactId>
    <version>5.7.0</version>
  </parent>

  <artifactId>xsdviewer</artifactId>
  <packaging>jar</packaging>

  <name>XsdViewer</name>
  <description>The tool: a local server serving the page that explores XML Schema, WSDL and Schematron files, built on xsdviewer-core and JToolsFramework, which its jar embeds.</description>

  <properties>
    <!-- this module is the program: its one jar, and with -Pdist its distributions (jtools-parent) -->
    <jtools.program.skip>false</jtools.program.skip>
    <jtools.app.id>xsdviewer</jtools.app.id>
    <jtools.app.name>XsdViewer</jtools.app.name>
    <jtools.app.mainClass>org.jtools.xsdviewer.XsdViewerApplication</jtools.app.mainClass>
    <jtools.app.port>8091</jtools.app.port>
    <jtools.app.windowsVersion>5.7.0.0</jtools.app.windowsVersion>
    <!-- the Temurin JDKs the runtimes are linked from, under their own names (README: Packaging; release.yml) -->
    <jtools.jdk.archives>${maven.multiModuleProjectDirectory}/jre</jtools.jdk.archives>
    <!-- the distributions carry the samples beside the program -->
    <jtools.dist.include>samples/**</jtools.dist.include>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.jtools</groupId>
      <artifactId>xsdviewer-core</artifactId>
    </dependency>
    <!-- JToolsFramework: the program around the server (the command line, the settings, the log, the stop once the
         last page has gone), the server itself, and the native file dialogs -->
    <dependency>
      <groupId>org.jtools.framework</groupId>
      <artifactId>jtools-app</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jtools.framework</groupId>
      <artifactId>jtools-desktop</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>xsdviewer</finalName>
    <plugins>
      <!-- the library is what goes to Maven Central, not the tool -->
      <plugin>
        <groupId>org.sonatype.central</groupId>
        <artifactId>central-publishing-maven-plugin</artifactId>
        <configuration>
          <skipPublishing>true</skipPublishing>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      mvn package -Pdist (scripts/package.sh): jtools-parent's distributions — a runtime jlink trims to what the jar
      needs, per platform whose Temurin JDK is in jre/, and the archives —, plus what XsdViewer's release publishes
      beside them and keeps alone in releases/:
        releases/xsdviewer-<version>-windows.zip    XsdViewer.exe (no console), xsdviewer.bat
        releases/xsdviewer-<version>-linux.tar.gz   xsdviewer.sh
        releases/xsdviewer-<version>-macos.tar.gz   xsdviewer.sh, Apple silicon
        releases/xsdviewer-<version>.jar            the jar alone, for a machine that has Java 21
    -->
    <profile>
      <id>dist</id>
      <build>
        <plugins>
          <!-- previous distributions (any version) are removed first: releases/ only ever holds this build's -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-clean-plugin</artifactId>
            <executions>
              <execution>
                <id>clean-previous-distributions</id>
                <phase>initialize</phase>
                <goals>
                  <goal>clean</goal>
                </goals>
                <configuration>
                  <excludeDefaultDirectories>true</excludeDefaultDirectories>
                  <filesets>
                    <fileset>
                      <directory>${maven.multiModuleProjectDirectory}/releases</directory>
                      <includes>
                        <include>${project.artifactId}-*-windows.zip</include>
                        <include>${project.artifactId}-*-linux.tar.gz</include>
                        <include>${project.artifactId}-*-macos.tar.gz</include>
                        <include>${project.artifactId}-*.jar</include>
                      </includes>
                    </fileset>
                  </filesets>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <!-- the jar alone, after jtools-parent's distributions in the same phase -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
              <execution>
                <id>the-jar-alone</id>
                <phase>package</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <copy file="${project.build.directory}/${project.build.finalName}.jar"
                          tofile="${maven.multiModuleProjectDirectory}/releases/${project.artifactId}-${project.version}.jar"/>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
