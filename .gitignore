target/
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# The externals: JDK, Maven, Node.js, the jmods the distributions' runtimes are linked from (scripts/linux/setup.sh, README: Packaging)
/external
# your mirror and its credentials (setup reads it on top of externals.conf)
/externals.local.conf
tmp/

# distributions built by "mvn package -Pdist" (scripts/linux/package.sh); only the README is tracked
/releases/*
!/releases/README.md

# workspaces saved from the GUI while testing (the shipped ones live in samples/compare/)
/samples/*.xsdviewer.json

# bytecode Python writes beside scripts/screenshots.py when it runs
__pycache__/
