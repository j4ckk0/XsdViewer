<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.jtools</groupId>
  <artifactId>xsdviewer-parent</artifactId>
  <version>4.13.0</version>
  <packaging>pom</packaging>

  <name>XsdViewer build</name>
  <description>Explore XML Schema, WSDL and Schematron files in the browser: a library that parses them into a graph, and the server serving the page.</description>
  <url>https://github.com/j4ckk0/XsdViewer</url>
  <inceptionYear>2026</inceptionYear>

  <organization>
    <name>jtools.org</name>
    <url>https://github.com/j4ckk0</url>
  </organization>

  <licenses>
    <license>
      <name>Apache License Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>j4ckk0</id>
      <name>Jacques HENRY</name>
      <email>j4ckk057@gmail.com</email>
      <organization>jtools.org</organization>
      <organizationUrl>https://github.com/j4ckk0</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/j4ckk0/XsdViewer.git</connection>
    <developerConnection>scm:git:git@github.com:j4ckk0/XsdViewer.git</developerConnection>
    <url>https://github.com/j4ckk0/XsdViewer</url>
    <tag>HEAD</tag>
  </scm>

  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/j4ckk0/XsdViewer/issues</url>
  </issueManagement>

  <!-- Two modules: core, the library that parses a schema into a graph and validates a document,
       with no dependency but the JDK; app, the server, the page and the distributions, which embeds
       core in the one jar users run. -->
  <modules>
    <module>core</module>
    <module>app</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.jtools</groupId>
        <artifactId>xsdviewer-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>5.8.2</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
          <configuration>
            <!-- the tests read the samples and the page from the root of the repository, whichever module they belong to -->
            <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>3.6.1</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>license-maven-plugin</artifactId>
          <version>2.4.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- Apache 2.0 header at the top of every Java source of every module (same convention as the jtools projects) -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <configuration>
          <verbose>false</verbose>
          <licenseName>apache_v2</licenseName>
          <organizationName>jtools.org</organizationName>
          <inceptionYear>2026</inceptionYear>
          <canUpdateCopyright>true</canUpdateCopyright>
        </configuration>
        <executions>
          <execution>
            <id>add-license-headers</id>
            <phase>process-sources</phase>
            <goals>
              <goal>update-file-header</goal>
            </goals>
            <configuration>
              <includes>
                <include>**/*.java</include>
              </includes>
              <roots>
                <root>src/main/java</root>
                <root>src/test</root>
              </roots>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
