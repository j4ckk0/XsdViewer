<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.jtools</groupId>
  <artifactId>xsdviewer</artifactId>
  <version>1.6.0</version>
  <packaging>jar</packaging>

  <name>XsdViewer</name>
  <description>Web-based viewer for XML Schema files: graph of the schema objects and their links, plus the source text.</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.8.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>xsdviewer</finalName>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <excludes>
          <!-- JRE archives used by the dist profile, not part of the jar -->
          <exclude>embedded/**</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>org.jtools.xsdviewer.XsdViewerApplication</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      mvn package -Pdist
      Builds the self-contained distributions, each with a bundled JRE
      (from src/main/resources/embedded/jre) and a launcher script:
        target/xsdviewer-<version>-windows.zip     xsdviewer.bat
        target/xsdviewer-<version>-linux.tar.gz    xsdviewer.sh
    -->
    <profile>
      <id>dist</id>
      <properties>
        <jre.archives>${project.basedir}/src/main/resources/embedded/jre</jre.archives>
        <jre.unpacked>${project.build.directory}/jre</jre.unpacked>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>unpack-jre</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <fail message="no *windows*.zip in ${jre.archives} (see README: Packaging)">
                      <condition>
                        <resourcecount count="0">
                          <fileset dir="${jre.archives}" includes="*windows*.zip" erroronmissingdir="false"/>
                        </resourcecount>
                      </condition>
                    </fail>
                    <fail message="no *linux*.tar.gz in ${jre.archives} (see README: Packaging)">
                      <condition>
                        <resourcecount count="0">
                          <fileset dir="${jre.archives}" includes="*linux*.tar.gz" erroronmissingdir="false"/>
                        </resourcecount>
                      </condition>
                    </fail>
                    <!-- cutdirsmapper strips the archives' top-level "jdk-xx-jre/" directory -->
                    <unzip dest="${jre.unpacked}/windows">
                      <fileset dir="${jre.archives}" includes="*windows*.zip"/>
                      <cutdirsmapper dirs="1"/>
                    </unzip>
                    <untar dest="${jre.unpacked}/linux" compression="gzip">
                      <fileset dir="${jre.archives}" includes="*linux*.tar.gz"/>
                      <cutdirsmapper dirs="1"/>
                    </untar>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-assembly-plugin</artifactId>
            <version>3.7.1</version>
            <executions>
              <execution>
                <id>dist</id>
                <phase>package</phase>
                <goals>
                  <goal>single</goal>
                </goals>
                <configuration>
                  <finalName>${project.artifactId}-${project.version}</finalName>
                  <appendAssemblyId>true</appendAssemblyId>
                  <descriptors>
                    <descriptor>src/assembly/windows.xml</descriptor>
                    <descriptor>src/assembly/linux.xml</descriptor>
                  </descriptors>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
